# Unreal Engine Bridge Settings
# Local server listens for frames from Unreal on LOCAL_PORT
LOCAL_PORT=8000

# External server (receives segmentation results forwarded from AI)
SERVER_URL=http://172.29.84.254:5000
REMOTE_RESULT_PATH=/unreal
FORWARD_TO_UNREAL=true

# Timeouts (seconds)
REMOTE_TIMEOUT=10
SAM2_TIMEOUT=30